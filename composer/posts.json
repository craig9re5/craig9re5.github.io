---
layout: null
permalink: /composer/posts.json
---
[
  {% for post in site.posts %}
    {
      "fileName": "{{ post.relative_path | remove: '_posts/' }}",
      "title": {{ post.title | jsonify }},
      "date": "{{ post.date | date: '%Y-%m-%d' }}",
      "publishAt": "{{ post.date | date: '%Y-%m-%dT%H:%M' }}",
      "lang": "{{ post.lang | default: 'zh-Hans' }}",
      "tags": {{ post.tags | jsonify }},
      "encrypted": {% if post.encrypted %}true{% else %}false{% endif %}
    }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
